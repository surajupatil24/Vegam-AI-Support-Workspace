function createSteps(stage: InvestigationStage): InvestigationStepData[] {
  const states: Record<InvestigationStage, StepStatus[]> = {
    analysis: ['completed', 'completed', 'completed', 'active', 'pending', 'waiting'],
    verification: ['completed', 'completed', 'completed', 'completed', 'active', 'waiting'],
    reporting: ['completed', 'completed', 'completed', 'completed', 'completed', 'active'],
    completed: ['completed', 'completed', 'completed', 'completed', 'completed', 'completed'],
  }

  const labels = [
    'Read Ticket\nfrom Redmine',
    'Search Similar\nTickets',
    'Code Analysis',
    'AI Analysis\n(ChatGPT)',
    'Claude Analysis\n(Optional)',
    'Generate Final\nReport',
  ]

  const timestamps = ['10:15:21 AM', '10:15:28 AM', '10:16:05 AM', '10:16:42 AM', '10:17:15 AM', '10:17:45 AM']

  return labels.map((label, index) => ({
    id: `step-${index + 1}`,
    label,
    status: states[stage][index],
    timestamp: states[stage][index] === 'pending' || states[stage][index] === 'waiting' ? undefined : timestamps[index],
  }))
}

function createInvestigationCards(stage: InvestigationStage): InvestigationCardData[] {
  const steps = createSteps(stage)

  return [
    {
      id: 'similar',
      title: 'Similar Tickets',
      description: 'Found 5 similar tickets. Top match has 92% similarity.',
      status: steps[1].status === 'active' ? 'active' : 'completed',
      icon: 'knowledge',
    },
    {
      id: 'code',
      title: 'Code Analysis',
      description: 'Analyzed 8 files, 3 services and 2 controllers. Potential issues found in AuthenticationService.',
      status: steps[2].status === 'active' ? 'active' : 'completed',
      icon: 'code',
    },
    {
      id: 'chatgpt',
      title: 'AI Analysis (ChatGPT)',
      description: 'Analyzing ticket, similar tickets, code references and logs. Generating root cause and recommended fix.',
      status: steps[3].status,
      icon: 'chatgpt',
    },
    {
      id: 'claude',
      title: 'Claude Analysis (Optional)',
      description: 'Cross-verifying analysis and generating alternate recommendations.',
      status: steps[4].status,
      icon: 'claude',
    },
    {
      id: 'report',
      title: 'Generate Final Report',
      description: 'Compiling final report with root cause, steps and resolution.',
      status: steps[5].status,
      icon: 'report',
    },
  ]
}

function buildConversation(ticketNumber: string, focus: string): ConversationEntry[] {
  return [
    {
      id: `${ticketNumber}-c1`,
      sender: 'engineer',
      name: 'Support Engineer',
      message: `Analyze ticket ${ticketNumber} and focus on ${focus}.`,
      timestamp: '10:16 AM',
    },
    {
      id: `${ticketNumber}-c2`,
      sender: 'ai',
      name: 'Samixa AI Agent',
      message: 'I found 5 similar tickets and the strongest pattern points to authentication and session handling.',
      timestamp: '10:16 AM',
    },
    {
      id: `${ticketNumber}-c3`,
      sender: 'engineer',
      name: 'Support Engineer',
      message: 'Cross-check the authentication service and compare the mobile stack traces.',
      timestamp: '10:17 AM',
    },
    {
      id: `${ticketNumber}-c4`,
      sender: 'ai',
      name: 'Samixa AI Agent',
      message: 'Code analysis flagged a likely regression in token validation. I am preparing the report and client response.',
      timestamp: '10:18 AM',
    },
  ]
}

function buildTimeline(ticketTitle: string, stage: InvestigationStage): TimelineEvent[] {
  const finalState = stage === 'completed' ? 'completed' : stage === 'reporting' ? 'active' : 'waiting'

  return [
    {
      id: `${ticketTitle}-t1`,
      time: '10:15:21',
      title: 'Ticket loaded from Redmine',
      detail: `Initial evidence and customer context collected for ${ticketTitle}.`,
      status: 'completed',
    },
    {
      id: `${ticketTitle}-t2`,
      time: '10:15:28',
      title: 'Similar ticket search completed',
      detail: 'Top historical match returned 92% similarity and linked supporting notes.',
      status: 'completed',
    },
    {
      id: `${ticketTitle}-t3`,
      time: '10:16:05',
      title: 'Code analysis completed',
      detail: 'Authentication and session-handling services were scanned for recent regressions.',
      status: 'completed',
    },
    {
      id: `${ticketTitle}-t4`,
      time: '10:16:18',
      title: 'ChatGPT analysis started',
      detail: 'LLM synthesis is comparing comments, logs, similar tickets, and code references.',
      status: stage === 'analysis' ? 'active' : 'completed',
    },
    {
      id: `${ticketTitle}-t5`,
      time: '10:16:32',
      title: 'Claude analysis queued',
      detail: 'Secondary model verification is preparing alternate recommendations.',
      status: stage === 'verification' ? 'active' : stage === 'analysis' ? 'pending' : 'completed',
    },
    {
      id: `${ticketTitle}-t6`,
      time: '10:17:00',
      title: 'Final report status',
      detail: finalState === 'completed' ? 'Final report generated and ready for export.' : 'Final report generation is waiting on the latest synthesis pass.',
      status: finalState,
    },
  ]
}

function buildHistory(ticketNumber: string): HistoryEvent[] {
  return [
    {
      id: `${ticketNumber}-h1`,
      time: '09/08/2026 10:15 AM',
      actor: 'Redmine Agent',
      title: 'Ticket synchronized',
      detail: 'Fresh ticket context, attachments, and recent comments were imported into Samixa.',
    },
    {
      id: `${ticketNumber}-h2`,
      time: '09/08/2026 10:16 AM',
      actor: 'Knowledge Agent',
      title: 'Similar incidents linked',
      detail: 'Knowledge base linked four comparable support cases and two internal runbooks.',
    },
    {
      id: `${ticketNumber}-h3`,
      time: '09/08/2026 10:17 AM',
      actor: 'Code Agent',
      title: 'Service scan completed',
      detail: 'Authentication-related files were ranked by probable relevance and impact.',
    },
    {
      id: `${ticketNumber}-h4`,
      time: '09/08/2026 10:18 AM',
      actor: 'Communication Agent',
      title: 'Draft client reply prepared',
      detail: 'A professional external response and an internal Redmine update were generated.',
    },
  ]
}


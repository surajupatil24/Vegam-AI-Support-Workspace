type TicketPriorityTone = 'critical' | 'high' | 'medium'
type TicketTracker = 'Bug' | 'SR'
type TabId = 'investigation' | 'ai-report' | 'conversation' | 'timeline' | 'attachments' | 'history'
type MobilePanelId = 'ticket' | 'investigation' | 'evidence'
type StepStatus = 'completed' | 'active' | 'pending' | 'waiting'
type InvestigationStage = 'analysis' | 'verification' | 'reporting' | 'completed'
type CardIconKey = 'knowledge' | 'code' | 'chatgpt' | 'claude' | 'report'
type SidebarIconKey = 'home' | 'team' | 'tickets' | 'investigation' | 'reports' | 'knowledge' | 'settings'

